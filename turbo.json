{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "ADMIN_SECRET",
    "DATABASE_URL",
    "EMAIL_FROM",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "PAYMENTS_ENABLED",
    "RESEND_ALLOWED_SENDERS",
    "RESEND_API_KEY",
    "RESEND_RECEIVING_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "SUPABASE_SERVICE_ROLE_KEY",
    "WHATSAPP_ENABLED",
    "NEXT_PUBLIC_WHATSAPP_ENABLED",
    "WHATSAPP_WORKER_SECRET",
    "WHATSAPP_BUSINESS_ACCOUNT_ID",
    "WHATSAPP_SENDER_NUMBER",
    "WHATSAPP_ADMIN_ENABLED",
    "WHATSAPP_ADMIN_NUMBER",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_ACCESS_TOKEN",
    "WHATSAPP_APP_SECRET",
    "WHATSAPP_VERIFY_TOKEN",
    "WHATSAPP_GRAPH_VERSION",
    "WHATSAPP_TEMPLATE_LANGUAGE",
    "WHATSAPP_TEMPLATE_BOOKING",
    "WHATSAPP_TEMPLATE_ENQUIRY",
    "WHATSAPP_TEMPLATE_ADMIN_BOOKING",
    "WHATSAPP_TEMPLATE_ADMIN_ENQUIRY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
