# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PASSWORD=
ADMIN_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Resend
RESEND_API_KEY=
# Server-only key with receiving permissions for inbound forwarding.
RESEND_RECEIVING_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional comma-separated exact addresses. Leave empty to forward all inbound
# messages to ADMIN_EMAIL for human review.
RESEND_ALLOWED_SENDERS=
EMAIL_FROM=noreply@cricprocoe.com
ADMIN_EMAIL=info@cricprocoe.com

# Stripe
PAYMENTS_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared rate limiter (server only; required for writes in production).
# Use one primary, strongly consistent Redis REST endpoint across workers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_KEY_SECRET=
# Distinct values for preview/production; only letters, digits, underscore, hyphen.
RATE_LIMIT_NAMESPACE=
# Explicit local/test fallback only; ignored in production.
RATE_LIMIT_LOCAL_FALLBACK=false

# Enable only after applying/reviewing the additive security migrations.
GUEST_BOOKING_ACCESS_ENABLED=false
AUTHORITATIVE_QUOTES_ENABLED=false
# Confirm historical timestamp conventions and admin rate units first.
BOOKING_TIMEZONE_VERIFIED=false
BOOKING_PRICE_UNITS=
# Server-only random secret, at least 32 characters, for the recovery scheduler.
# Scheduler is not provisioned automatically.
CRON_SECRET=

# Coupon management can prepare drafts before checkout is activated.
# Apply the coupon migration and test providers before enabling.
CHECKOUT_PROMOTIONS_ENABLED=false
# Stable server-only random secret (32+ characters) for cross-code email limits.
# Changing this requires a reviewed identity-key migration, not a blind rotation.
COUPON_IDENTITY_SECRET=
